\name{HeteroSpaSim-methods}
\alias{print.HeteroSpaSim}
\alias{summary.HeteroSpaSim}
\alias{plot.HeteroSpaSim}
\title{Methods for HeteroSpaSim objects}
\usage{
\method{print}{HeteroSpaSim}(x, ...)

\method{summary}{HeteroSpaSim}(object, ...)

\method{plot}{HeteroSpaSim}(x, what = c("domains", "celltypes", "modalities"), 
    ...)
}
\description{Compact printing, summary tables and spatial diagnostic plots.}

\arguments{
\item{x}{A simulation object.}
\item{...}{Additional configuration or method arguments as described for the relevant function.}
\item{object}{A HeteroSpaSim simulation object.}
\item{what}{Argument to print.HeteroSpaSim; see the function description and release manual.}
}
